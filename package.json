{
  "name": "carrera-sysadmin",
  "private": true,
  "version": "0.2.0",
  "description": "Plataforma interactiva con la carrera completa de administración de servidores e infraestructura.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "cross-env CONTENT_DIR=tests/fixtures/content vite",
    "build": "npm run validar && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validar": "tsx scripts/validar-contenido.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lezer/highlight": "1.2.5",
    "@xyflow/react": "12.12.0",
    "codemirror": "6.0.2",
    "dexie": "4.4.7",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "ts-fsrs": "5.4.2",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
